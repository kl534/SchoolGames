{
  "name": "schoolgames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "voice:lines": "tsx scripts/voice/lines.ts",
    "voice": "npm run voice:lines && uv run scripts/voice/generate.py",
    "test:all": "FULL_TESTS=1 vitest run",
    "check": "tsx scripts/check.ts",
    "shots": "tsx scripts/shots/main.ts",
    "maps": "tsx scripts/maps/us-states.ts && tsx scripts/maps/world.ts"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "d3-geo": "^3.1.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "us-atlas": "^3.0.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "world-atlas": "^2.0.2"
  }
}
